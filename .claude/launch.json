{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "server/.venv/bin/python",
      "runtimeArgs": ["server/manage.py", "runserver", "127.0.0.1:8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "cwd": "client",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/next/dist/bin/next", "dev"],
      "port": 3000
    }
  ]
}
