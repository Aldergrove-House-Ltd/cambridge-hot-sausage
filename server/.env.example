DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — leave empty for SQLite (dev default)
# Set to postgres://user:pass@host:5432/dbname on prod
DATABASE_URL=
# In compose/prod, SQLite lives on a named volume at /app/db/db.sqlite3
SQLITE_PATH=

# Cache — leave empty for LocMemCache (dev default)
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
FRONTEND_URL=http://localhost:3000

# Object Storage (Railway Bucket / S3-compatible) — leave empty for local media
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=
