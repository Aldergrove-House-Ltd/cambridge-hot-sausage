DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — leave empty for SQLite (dev default)
# Set to postgres://user:pass@host:5432/dbname on prod
DATABASE_URL=
# In compose/prod, SQLite lives on a named volume at /app/db/db.sqlite3
SQLITE_PATH=

# Cache — leave empty for LocMemCache (dev default)
REDIS_URL=

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
FRONTEND_URL=http://localhost:3000

# Object Storage (Railway Bucket / S3-compatible) — leave empty for local media
BUCKET_ENDPOINT=
BUCKET_ACCESS_KEY=
BUCKET_SECRET_KEY=
BUCKET_NAME=

# Google reviews (reviews page). Places API (New) key, used server-side only.
# GOOGLE_PLACE_ID defaults to the Fitzroy Street listing when empty.
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_PLACE_ID=
# Google is called at most once per cache period (6 h ≈ 120 calls/month);
# the last good result is served for up to the stale period if Google fails.
GOOGLE_REVIEWS_CACHE_SECONDS=21600
GOOGLE_REVIEWS_STALE_SECONDS=172800
# Hard cap on billed Place Details calls per month (free tier ≈ 1,000).
# Defaults: 600 in production, 100 when DEBUG=True.
GOOGLE_PLACES_MONTHLY_CAP=600

RESEND_API_KEY=your-resend-api-key
