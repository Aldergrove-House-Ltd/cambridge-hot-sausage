# Compose-root envs used by docker-compose.yml.
# Local dev: cp .env.example .env  (compose auto-loads ./.env)
# Coolify:   set these in the stack's Environment Variables UI.

# --- Django ---
SECRET_KEY=change-me-generate-with-django-get_random_secret_key
DEBUG=False
# Comma-separated. For Coolify, include the public FQDN you set in Coolify
# (e.g. hotsausagecompany.com,www.hotsausagecompany.com) plus the Coolify-assigned
# sslip.io hostname while there's no custom domain yet.
ALLOWED_HOSTS=change.me.sslip.io
CSRF_TRUSTED_ORIGINS=https://change.me.sslip.io
CORS_ALLOWED_ORIGINS=https://change.me.sslip.io
FRONTEND_URL=https://change.me.sslip.io

# --- Stripe (optional until live payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
